{
  "name": "RAILbench",
  "version": "0.6.1",
  "description": "Modellbahn Gleisplanungs-Tool",
  "author": "RAILbench Team",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server.mjs",
    "serve": "node server.mjs",
    "collab": "node server.mjs",
    "benchmark": "node scripts/benchmark-resources.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"fs.writeFileSync('dist-electron/package.json', '{\\\"type\\\": \\\"commonjs\\\"}')\"",
    "build:all": "npm run build && npm run build:electron",
    "electron:dev": "npm run build:electron && electron .",
    "dist:linux": "npm run build:all && electron-builder --linux AppImage",
    "dist:linux:appimage": "npm run build:all && electron-builder --linux AppImage --x64",
    "dist:linux:appimage:x64": "npm run build:all && electron-builder --linux AppImage --x64",
    "dist:linux:appimage:arm64": "npm run build:all && electron-builder --linux AppImage --arm64",
    "dist:linux:appimage:all": "npm run build:all && electron-builder --linux AppImage --x64 --arm64",
    "dist:linux:dir": "npm run build:all && electron-builder --linux dir",
    "dist:linux:tar": "npm run dist:linux:dir && tar -czf release/railbench-0.6.1-linux-x64.tar.gz -C release/linux-unpacked .",
    "dist:linux:flatpak": "bash scripts/build-flatpak.sh",
    "dist:win": "bash scripts/build-windows-portable.sh all",
    "dist:win:dir": "npm run build:all && electron-builder --win dir",
    "dist:win:dir:x64": "npm run build:all && electron-builder --win dir --x64",
    "dist:win:dir:arm64": "npm run build:all && electron-builder --win dir --arm64",
    "dist:win:dir:all": "npm run build:all && electron-builder --win dir --x64 --arm64",
    "dist:win:zip": "bash scripts/build-windows-portable.sh all",
    "dist:win:zip:x64": "bash scripts/build-windows-portable.sh x64",
    "dist:win:zip:arm64": "bash scripts/build-windows-portable.sh arm64",
    "dist:win:zip:all": "bash scripts/build-windows-portable.sh all",
    "dist:win:portable": "bash scripts/build-windows-portable.sh x64",
    "dist:win:portable:x64": "bash scripts/build-windows-portable.sh x64",
    "dist:win:portable:arm64": "bash scripts/build-windows-portable.sh arm64",
    "dist:win:portable:all": "bash scripts/build-windows-portable.sh all",
    "dist:mac": "bash scripts/build-macos.sh all both",
    "dist:mac:all": "bash scripts/build-macos.sh all both",
    "dist:mac:both": "bash scripts/build-macos.sh all both",
    "dist:mac:zip": "bash scripts/build-macos.sh all zip",
    "dist:mac:zip:x64": "bash scripts/build-macos.sh x64 zip",
    "dist:mac:zip:arm64": "bash scripts/build-macos.sh arm64 zip",
    "dist:mac:zip:all": "bash scripts/build-macos.sh all zip",
    "dist:mac:dmg": "bash scripts/build-macos.sh all dmg",
    "dist:mac:dmg:x64": "bash scripts/build-macos.sh x64 dmg",
    "dist:mac:dmg:arm64": "bash scripts/build-macos.sh arm64 dmg",
    "dist:mac:dmg:all": "bash scripts/build-macos.sh all dmg",
    "dist:mac:script": "bash scripts/build-macos.sh all dmg",
    "dist:mac:script:dmg": "bash scripts/build-macos.sh all dmg",
    "dist:mac:script:zip": "bash scripts/build-macos.sh all zip",
    "dist:all": "npm run dist:win:portable:all && npm run dist:linux:appimage:all && npm run dist:mac"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "pixi.js": "^8.0.0",
    "three": "^0.187.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "de.railbench.app",
    "productName": "railbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Graphics"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.exe"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.AppImage"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.dmg",
      "backgroundColor": "#1a1e24",
      "contents": [
        {
          "x": 130,
          "y": 170,
          "type": "file"
        },
        {
          "x": 410,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
