{
  "name": "gleisplan",
  "version": "0.4.0",
  "description": "Modellbahn Gleisplanungs-Tool",
  "author": "Gleisplan Team",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server.mjs",
    "serve": "node server.mjs",
    "collab": "node server.mjs",
    "benchmark": "node scripts/benchmark-resources.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"fs.writeFileSync('dist-electron/package.json', '{\\\"type\\\": \\\"commonjs\\\"}')\"",
    "build:all": "npm run build && npm run build:electron",
    "electron:dev": "npm run build:electron && electron .",
    "dist:linux": "npm run build:all && electron-builder --linux AppImage",
    "dist:linux:appimage": "npm run build:all && electron-builder --linux AppImage --x64",
    "dist:linux:appimage:x64": "npm run build:all && electron-builder --linux AppImage --x64",
    "dist:linux:appimage:arm64": "npm run build:all && electron-builder --linux AppImage --arm64",
    "dist:linux:appimage:all": "npm run build:all && electron-builder --linux AppImage --x64 --arm64",
    "dist:linux:dir": "npm run build:all && electron-builder --linux dir",
    "dist:linux:flatpak": "bash scripts/build-flatpak.sh",
    "dist:win": "npm run build:all && electron-builder --win portable nsis",
    "dist:win:portable": "npm run build:all && electron-builder --win portable --x64",
    "dist:win:portable:x64": "npm run build:all && electron-builder --win portable --x64",
    "dist:win:portable:arm64": "npm run build:all && electron-builder --win portable --arm64",
    "dist:win:portable:all": "npm run build:all && electron-builder --win portable --x64 --arm64",
    "dist:mac": "npm run dist:mac:zip:all",
    "dist:mac:zip:x64": "npm run build:all && electron-builder --mac zip --x64",
    "dist:mac:zip:arm64": "npm run build:all && electron-builder --mac zip --arm64",
    "dist:mac:zip:all": "npm run build:all && electron-builder --mac zip --x64 --arm64",
    "dist:mac:dmg": "npm run build:all && electron-builder --mac dmg",
    "dist:all": "npm run dist:win:portable:all && npm run dist:linux:appimage:all && npm run dist:mac:zip:all"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "pixi.js": "^8.0.0",
    "three": "^0.187.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "de.gleisplan.app",
    "productName": "Gleisplan",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Graphics"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.exe"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.AppImage"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
